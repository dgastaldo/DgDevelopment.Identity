<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DgDevelopment.Identity.Client.Maui.Pages.MainPage"
             Title="Home">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label x:Name="WelcomeLabel" FontSize="20" />
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
        <Button Text="Multi-factor authentication" Clicked="OnMfaClicked" />
        <Button Text="Logout" Clicked="OnLogoutClicked" />
        <ActivityIndicator x:Name="Spinner" IsRunning="True" />
    </VerticalStackLayout>
</ContentPage>
