# Copy to .env (gitignored) on the NUC and fill in real values. Never commit the real .env.

SQL_SA_PASSWORD=change-me-to-a-strong-password

# Public URL the identity-platform app is actually reached at (browser-facing), used to build
# absolute links/redirects - e.g. http://<nuc-lan-ip>:8082 or a domain if you put a reverse proxy
# in front later.
IDENTITY_PLATFORM_PUBLIC_URL=http://localhost:8082

# No admin OAuth client id/secret to set here - identity-server generates them itself on first
# seed (random, per environment) and writes them to the `admin-client-config` volume shared with
# identity-platform, which reads them automatically. See README.md and
# src/DgDevelopment.Identity.Server/Data/DbSeeder.cs.

# Absolute path to a Docker config.json holding GHCR read:packages credentials (see README.md's
# "one-time setup" - created by `docker login ghcr.io`). Mounted read-only into Watchtower so it can
# pull the private images too.
GHCR_DOCKER_CONFIG_FILE=/home/YOUR_USER/.docker/config.json
