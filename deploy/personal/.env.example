# Copy to .env (gitignored) on the NUC and fill in real values. Never commit the real .env.

SQL_SA_PASSWORD=change-me-to-a-strong-password

# Public URL the identity-platform app is actually reached at (browser-facing), used to build
# absolute links/redirects - either the LAN address (http://<nuc-lan-ip>:8082) or, once nginx is
# set up for public access (see README.md's "Public access (nginx + step-ca)"), the real domain -
# https://identity-admin.homenet.dgdevelopment.it, no port (nginx listens on the standard 443).
IDENTITY_PLATFORM_PUBLIC_URL=http://localhost:8082

# Public URL identity-server is actually reached at (browser-facing) - NOT the Docker-internal
# http://identity-server:8080 used for server-to-server calls. Needed for the OAuth
# /connect/authorize and /connect/endsession redirects the browser follows, for the WASM
# client (runs entirely in-browser), and (alongside the internal URL) as one of the valid OAuth
# token issuer values identity-server accepts. Same LAN-vs-public-domain choice as
# IDENTITY_PLATFORM_PUBLIC_URL above - https://idp.homenet.dgdevelopment.it once nginx is set up.
IDENTITY_SERVER_PUBLIC_URL=http://localhost:8081

# No admin OAuth client id/secret to set here - identity-server generates them itself on first
# seed (random, per environment) and writes them to the `admin-client-config` volume shared with
# identity-platform, which reads them automatically. See README.md and
# src/DgDevelopment.Identity.Server/Data/DbSeeder.cs.

# Only needed once nginx is in front of the two apps for public access - see README.md's "Public
# access (nginx + step-ca)". Leave both unset for LAN-only access straight at :8081/:8082.
#
# Must match deploy/personal/docker-compose.yml's identity-net subnet exactly - identity-server/
# identity-platform only trust X-Forwarded-Proto/X-Forwarded-For from addresses inside this range
# (i.e. only from nginx, which lives on identity-net, never from a LAN client hitting :8081/:8082
# directly and trying to forge those headers).
TRUSTED_PROXY_SUBNET=172.28.0.0/24
#
# Absolute path, on the NUC, to the directory your step-ca issuance/renewal process writes the
# two domains' certificates into - nginx mounts it read-only. Expected layout (fullchain.pem +
# privkey.pem per domain, matching deploy/personal/nginx/identity.conf):
#   <dir>/idp.homenet.dgdevelopment.it/{fullchain.pem,privkey.pem}
#   <dir>/identity-admin.homenet.dgdevelopment.it/{fullchain.pem,privkey.pem}
# nginx does not pick up a renewed certificate on its own - run
# `docker compose exec nginx nginx -s reload` (or restart the container) after step-ca renews one,
# e.g. as a post-renewal hook on the step-ca machine.
TLS_CERTS_DIR=/home/YOUR_USER/identity-certs

# Absolute path to a Docker config.json holding GHCR read:packages credentials (see README.md's
# "one-time setup" - created by `docker login ghcr.io`). Mounted read-only into Watchtower so it can
# pull the private images too.
GHCR_DOCKER_CONFIG_FILE=/home/YOUR_USER/.docker/config.json
