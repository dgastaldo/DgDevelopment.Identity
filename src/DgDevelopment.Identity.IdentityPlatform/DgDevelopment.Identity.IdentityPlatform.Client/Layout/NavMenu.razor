@using DgDevelopment.Identity.Client.Core
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject TenantState TenantState

<div class="flex h-14 items-center bg-black/40">
    <div class="w-full px-3">
        <a class="text-lg text-white no-underline" href="">Identity Console</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <AuthorizeView>
        <Authorized Context="authState">
            <nav class="flex flex-col">
                <div class="nav-item px-3 pb-2 pt-4">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="mr-3 inline-block" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5Z" />
                        </svg> Home
                    </NavLink>
                </div>
                @if (authState.User.HasPermission("identity-platform.user.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="users">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">◈</span> Users
                        </NavLink>
                    </div>
                }
                @if (authState.User.HasPermission("identity-platform.role.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="roles">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">▤</span> Roles
                        </NavLink>
                    </div>
                }
                @if (authState.User.HasPermission("identity-platform.group.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="groups">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">▥</span> Groups
                        </NavLink>
                    </div>
                }
                @if (authState.User.HasPermission("identity-platform.client.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="clients">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">◆</span> Clients
                        </NavLink>
                    </div>
                }
                @if (authState.User.HasPermission("identity-platform.platform.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="platforms">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">▧</span> Platforms
                        </NavLink>
                    </div>
                }
                @if (authState.User.HasPermission("identity-platform.audit.read"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="audit">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">☰</span> Audit log
                        </NavLink>
                    </div>
                }
                @if (TenantState.IsGlobalAdministrator)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tenants">
                            <span class="mr-3 inline-block w-4 text-center text-xs" aria-hidden="true">⬡</span> Tenants
                        </NavLink>
                    </div>
                }
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    protected override void OnInitialized()
    {
        TenantState.Changed += OnTenantStateChanged;
    }

    private void OnTenantStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        TenantState.Changed -= OnTenantStateChanged;
    }
}
