@inherits LayoutComponentBase
@using DgDevelopment.Identity.Client.Blazor
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@using Microsoft.AspNetCore.Components.Authorization
@inject IdentityAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject TenantState TenantState

<div class="flex min-h-screen flex-col">
    <div class="relative flex flex-1 flex-col md:flex-row">
        <div class="bg-gradient-to-b from-[#052767] to-[#3a0647] md:sticky md:top-0 md:h-screen md:shrink-0 md:w-60">
            <NavMenu />
        </div>

        <main class="flex flex-1 flex-col">
            <div class="flex h-14 items-center justify-end border-b border-gray-300 bg-gray-100 px-4 md:sticky md:top-0 md:z-10">
                <div class="flex items-center gap-4">
                    <AuthorizeView>
                        <Authorized>
                            @if (TenantState.Loaded && TenantState.Tenants.Count > 1)
                            {
                                <select class="rounded-md border-gray-300 text-sm" value="@TenantState.ActiveTenantId" @onchange="SwitchTenantAsync">
                                    @foreach (var tenant in TenantState.Tenants)
                                    {
                                        <option value="@tenant.Id">@tenant.Name</option>
                                    }
                                </select>
                            }
                            else if (TenantState.Loaded && TenantState.ActiveTenant is not null)
                            {
                                <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">@TenantState.ActiveTenant.Name</span>
                            }
                            @if (TenantState.IsGlobalAdministrator)
                            {
                                <label class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
                                    <input type="checkbox" @bind="TenantState.AllTenants" @bind:after="StateHasChanged" />
                                    All tenants
                                </label>
                            }
                            <span class="avatar flex h-8 w-8 items-center justify-center rounded-full bg-[#3a0647] text-xs font-semibold text-white uppercase">@GetInitials(context.User.Identity?.Name)</span>
                            <span class="font-semibold">@context.User.Identity?.Name</span>
                            <button type="button" class="btn-link" @onclick="LogoutAsync">Logout</button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn-link">Login</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <article class="flex-1 px-4 py-4 md:px-8 md:py-6">
                @Body
            </article>
        </main>
    </div>

    <footer class="shrink-0 border-t border-gray-300 bg-gray-100 px-6 py-3 text-center text-sm text-gray-500">
        <span>DgDevelopment.Identity by <a href="https://github.com/dgastaldo" target="_blank" class="text-brand-600 hover:underline">dgastaldo</a></span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        AuthStateProvider.ForceLoggedOut += OnForceLoggedOut;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser())
            return;

        try
        {
            await TenantState.LoadAsync().ConfigureAwait(false);
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException)
        {
            // Anonymous or unauthenticated requests fail here; the tenant bar simply stays hidden.
        }
    }

    // The server pushed a force-logout event (password changed elsewhere) - AuthStateProvider has
    // already cleared tokens and renotified auth state by the time this fires; this just gets the
    // user back to a fresh, unauthenticated page.
    private void OnForceLoggedOut(object? sender, EventArgs e)
    {
        InvokeAsync(() => Navigation.NavigateTo("/", forceLoad: true));
    }

    public void Dispose()
    {
        AuthStateProvider.ForceLoggedOut -= OnForceLoggedOut;
    }

    private async Task SwitchTenantAsync(ChangeEventArgs args)
    {
        if (args.Value is not string value || !Guid.TryParse(value, out var tenantId))
            return;

        var tenant = TenantState.Tenants.FirstOrDefault(t => t.Id == tenantId);
        if (tenant is null || tenant.Id == TenantState.ActiveTenantId)
            return;

        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo($"/login?tenant={Uri.EscapeDataString(tenant.Slug)}", forceLoad: true);
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split([' ', '.', '-', '_'], StringSplitOptions.RemoveEmptyEntries);

        var initials = parts
            .Select(p => p[0])
            .Take(2)
            .Select(char.ToUpperInvariant)
            .ToArray();

        return new string(initials);
    }

    private async Task LogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}