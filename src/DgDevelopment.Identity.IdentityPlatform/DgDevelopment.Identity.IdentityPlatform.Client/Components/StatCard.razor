<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between"><p class="text-sm font-medium text-slate-500">@Label</p><span class="h-2.5 w-2.5 rounded-full @(Accent switch { "emerald" => "bg-emerald-500", "amber" => "bg-amber-500", "sky" => "bg-sky-500", _ => "bg-violet-500" })"></span></div>
    <p class="mt-5 text-3xl font-semibold tracking-tight text-slate-900">@Value</p><p class="mt-1 text-xs text-slate-400">@Detail</p>
</div>
@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public string Detail { get; set; } = string.Empty;
    [Parameter] public string Accent { get; set; } = string.Empty;
}
