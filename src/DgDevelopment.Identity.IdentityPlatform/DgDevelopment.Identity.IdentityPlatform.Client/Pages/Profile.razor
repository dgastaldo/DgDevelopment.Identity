@page "/profile"
@inject IdentityClient Api

<PageTitle>Profile | IdentityPlatform</PageTitle>

@if (Loading)
{
    <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
}
else if (Me is null)
{
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm text-rose-800">@Error</div>
}
else
{
    <div class="mb-8">
        <p class="text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">Account</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Profile</h1>
        <p class="mt-2 text-sm text-slate-500">@Me.Username</p>
    </div>

    @if (Error is not null)
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div>
    }

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Email addresses</p>
        <ul class="mt-4 divide-y divide-slate-100">
            @foreach (var email in Me.Emails)
            {
                <li class="flex items-center justify-between py-3">
                    <div>
                        <p class="text-sm font-semibold text-slate-800">@email.Email</p>
                        <div class="mt-1 flex gap-2">
                            @if (email.IsPrimary)
                            {
                                <span class="rounded-full bg-violet-50 px-2 py-0.5 text-xs font-semibold text-violet-700">Primary</span>
                            }
                            <span class="rounded-full px-2 py-0.5 text-xs font-semibold @(email.IsVerified ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(email.IsVerified ? "Verified" : "Unverified")</span>
                        </div>
                    </div>
                    @if (!email.IsPrimary)
                    {
                        <div class="flex gap-3">
                            <button disabled="@Busy" @onclick="() => SetPrimaryAsync(email.Email)" class="text-xs font-semibold text-violet-700 hover:text-violet-900">Make primary</button>
                            <button disabled="@Busy" @onclick="() => RemoveEmailAsync(email.Email)" class="text-xs font-semibold text-rose-600 hover:text-rose-800">Remove</button>
                        </div>
                    }
                </li>
            }
        </ul>
        <EditForm Model="AddEmailModel" OnValidSubmit="AddEmailAsync" class="mt-4 flex items-end gap-3">
            <div class="flex-1"><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Add email</label><InputText @bind-Value="AddEmailModel.Email" class="w-full rounded-lg border-slate-300" /></div>
            <button disabled="@Busy" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800">Add</button>
        </EditForm>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Password</p>
        <EditForm Model="PasswordModel" OnValidSubmit="ChangePasswordAsync" class="mt-4 grid gap-4 md:grid-cols-3">
            <div>
                <label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Current password</label>
                <input type="password" @bind="PasswordModel.CurrentPassword" class="w-full rounded-lg border-slate-300" />
            </div>
            <div>
                <label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">New password</label>
                <input type="password" @bind="PasswordModel.NewPassword" class="w-full rounded-lg border-slate-300" />
            </div>
            <div>
                <label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Confirm new password</label>
                <input type="password" @bind="PasswordModel.ConfirmPassword" class="w-full rounded-lg border-slate-300" />
            </div>
            <div class="md:col-span-3"><button disabled="@Busy" class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800">Change password</button></div>
        </EditForm>
    </section>
}

@code {
    private MeResponse? Me;
    private bool Loading = true;
    private bool Busy;
    private string? Error;
    private AddEmailForm AddEmailModel = new();
    private ChangePasswordForm PasswordModel = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Me = await Api.GetMeAsync().ConfigureAwait(false);
        }
        catch (HttpRequestException)
        {
            Error = "Your profile could not be loaded.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddEmailAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            await Api.AddEmailAsync(AddEmailModel.Email).ConfigureAwait(false);
            AddEmailModel = new();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The email address could not be added."; }
        finally { Busy = false; }
    }

    private async Task RemoveEmailAsync(string email)
    {
        Busy = true;
        Error = null;
        try
        {
            using var response = await Api.RemoveEmailAsync(email).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The email address could not be removed."; }
        finally { Busy = false; }
    }

    private async Task SetPrimaryAsync(string email)
    {
        Busy = true;
        Error = null;
        try
        {
            using var response = await Api.SetPrimaryEmailAsync(email).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The primary email could not be changed."; }
        finally { Busy = false; }
    }

    private async Task ChangePasswordAsync()
    {
        if (!string.Equals(PasswordModel.NewPassword, PasswordModel.ConfirmPassword, StringComparison.Ordinal))
        {
            Error = "Passwords do not match.";
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            using var response = await Api.ChangePasswordAsync(PasswordModel.CurrentPassword, PasswordModel.NewPassword).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            PasswordModel = new();
        }
        catch (HttpRequestException) { Error = "The password could not be changed. Check your current password and try again."; }
        finally { Busy = false; }
    }

    private sealed class AddEmailForm
    {
        public string Email { get; set; } = string.Empty;
    }

    private sealed class ChangePasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
