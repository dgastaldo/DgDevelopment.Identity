@page "/login"
@using DgDevelopment.Identity.Client.Blazor
@inject NavigationManager Navigation
@inject IdentityAuthStateProvider AuthStateProvider
@inject ISessionStorageService SessionStorage

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var (verifier, challenge) = IdentityAuthStateProvider.GeneratePkce();
        await SessionStorage.SetItemAsync("pkce_verifier", verifier);

        Navigation.NavigateTo(AuthStateProvider.GetLoginUrl(state: null, codeChallenge: challenge).ToString(), forceLoad: true);
    }
}