@page "/platforms/{Id:guid}"
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@inject IdentityClient Api
@inject NavigationManager Navigation
@inject TenantState TenantState

<PageTitle>Platform details | IdentityPlatform</PageTitle>

<RequirePermission Permission="identity-platform.platform.read">
    @if (Loading)
    {
        <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
    }
    else if (Platform is null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm text-rose-800">@Error</div>
    }
    else
    {
        <div class="mb-8 flex items-end justify-between gap-4">
            <div>
                <button class="mb-4 text-sm font-semibold text-violet-700" @onclick="Back">← Platforms</button>
                <p class="text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">Platform detail</p>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">@Platform.Name</h1>
                <p class="mt-2 text-sm text-slate-500">@Platform.Description</p>
            </div>
            <button disabled="@Busy" @onclick="DeleteAsync" class="rounded-lg bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100">Delete platform</button>
        </div>
        @if (Error is not null) { <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div> }

        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Settings</p>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" class="mt-4 grid gap-4 md:grid-cols-3">
                <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Name</label><InputText @bind-Value="EditModel.Name" class="w-full rounded-lg border-slate-300" /></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Description</label><InputText @bind-Value="EditModel.Description" class="w-full rounded-lg border-slate-300" /></div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Permission mode</label>
                    <select @bind="EditModel.PermissionMode" class="w-full rounded-lg border-slate-300 text-sm">
                        <option value="@PermissionMode.AuthOnly">Auth only</option>
                        <option value="@PermissionMode.IdentityManaged">Identity managed</option>
                    </select>
                </div>
                <div class="md:col-span-3"><button disabled="@Busy" class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800">Save changes</button></div>
            </EditForm>
        </section>
    }
</RequirePermission>

@code {
    [Parameter] public Guid Id { get; set; }
    private PlatformResponse? Platform;
    private bool Loading = true;
    private bool Busy;
    private string? Error;
    private EditPlatformForm EditModel = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Platform = await Api.GetPlatformAsync(Id, TenantState.AllTenants).ConfigureAwait(false);
            if (Platform is null) { Error = "Platform not found."; return; }

            EditModel = new EditPlatformForm { Name = Platform.Name, Description = Platform.Description, PermissionMode = Platform.PermissionMode };
        }
        catch (HttpRequestException)
        {
            Error = "The platform could not be loaded.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        Busy = true;
        try
        {
            using var response = await Api.UpdatePlatformAsync(Id, EditModel.Name, EditModel.Description, EditModel.PermissionMode, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The platform could not be updated."; }
        finally { Busy = false; }
    }

    private async Task DeleteAsync()
    {
        Busy = true;
        try
        {
            using var response = await Api.DeletePlatformAsync(Id, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo("/platforms");
        }
        catch (HttpRequestException) { Error = "The platform could not be deleted."; }
        finally { Busy = false; }
    }

    private void Back() => Navigation.NavigateTo("/platforms");

    private sealed class EditPlatformForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public PermissionMode PermissionMode { get; set; }
    }
}
