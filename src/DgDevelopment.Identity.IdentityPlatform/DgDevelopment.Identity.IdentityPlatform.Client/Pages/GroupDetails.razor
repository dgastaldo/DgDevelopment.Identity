@page "/groups/{Id:guid}"
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@inject IdentityClient Api
@inject NavigationManager Navigation
@inject TenantState TenantState

<PageTitle>Group details | IdentityPlatform</PageTitle>

<RequirePermission Permission="identity-platform.group.read">
    @if (Loading)
    {
        <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
    }
    else if (Group is null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm text-rose-800">@Error</div>
    }
    else
    {
        <div class="mb-8 flex items-end justify-between gap-4">
            <div>
                <button class="mb-4 text-sm font-semibold text-violet-700" @onclick="Back">← Groups</button>
                <p class="text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">Group detail</p>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">@Group.Name</h1>
                <p class="mt-2 text-sm text-slate-500">@Group.Description</p>
            </div>
            <button disabled="@Busy" @onclick="DeleteAsync" class="rounded-lg bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100">Delete group</button>
        </div>
        @if (Error is not null) { <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div> }

        <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Rename</p>
                <EditForm Model="EditModel" OnValidSubmit="SaveAsync" class="mt-4 grid gap-4">
                    <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Name</label><InputText @bind-Value="EditModel.Name" class="w-full rounded-lg border-slate-300" /></div>
                    <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Description</label><InputText @bind-Value="EditModel.Description" class="w-full rounded-lg border-slate-300" /></div>
                    <div><button disabled="@Busy" class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800">Save changes</button></div>
                </EditForm>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Parent group</p>
                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <select @bind="SelectedParentId" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm">
                        <option value="">No parent (top-level)</option>
                        @foreach (var candidate in ParentCandidates)
                        {
                            <option value="@candidate.Id">@candidate.Name</option>
                        }
                    </select>
                    <button disabled="@Busy" @onclick="SetParentAsync" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800">Save parent</button>
                </div>
                @if (Group.ParentGroupId is { } parentId)
                {
                    <p class="mt-3 text-xs text-slate-400">Current parent: @(AllGroups.FirstOrDefault(g => g.Id == parentId)?.Name ?? parentId.ToString())</p>
                }
            </section>
        </div>

        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Roles</p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                <select @bind="SelectedRoleId" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm">
                    <option value="">Select a role to add…</option>
                    @foreach (var role in AvailableRoles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
                <button disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedRoleId))" @onclick="AssignRoleAsync" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:opacity-50">Assign</button>
            </div>
            <ul class="mt-5 divide-y divide-slate-100">
                @foreach (var assigned in Group.Roles)
                {
                    <li class="flex items-center justify-between py-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-800">@RoleName(assigned.RoleId)</p>
                            @if (assigned.ScopeType is not null)
                            {
                                <p class="text-xs text-slate-400">Scope: @assigned.ScopeType = @assigned.ScopeValue</p>
                            }
                        </div>
                        <button disabled="@Busy" @onclick="() => RemoveRoleAsync(assigned.RoleId)" class="text-xs font-semibold text-rose-600 hover:text-rose-800">Remove</button>
                    </li>
                }
                @if (Group.Roles.Count == 0)
                {
                    <li class="py-3 text-sm text-slate-400">No roles assigned yet.</li>
                }
            </ul>
        </section>
    }
</RequirePermission>

@code {
    [Parameter] public Guid Id { get; set; }
    private GroupResponse? Group;
    private IReadOnlyCollection<GroupResponse> AllGroups = [];
    private IReadOnlyCollection<RoleResponse> AllRoles = [];
    private bool Loading = true;
    private bool Busy;
    private string? Error;
    private string SelectedRoleId = string.Empty;
    private string SelectedParentId = string.Empty;
    private EditGroupForm EditModel = new();

    private IEnumerable<GroupResponse> ParentCandidates
        => AllGroups.Where(g => g.Id != Id);

    private IEnumerable<RoleResponse> AvailableRoles
        => AllRoles.Where(r => Group is not null && Group.Roles.All(gr => gr.RoleId != r.Id));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Group = await Api.GetGroupAsync(Id, TenantState.AllTenants).ConfigureAwait(false);
            if (Group is null) { Error = "Group not found."; return; }

            EditModel = new EditGroupForm { Name = Group.Name, Description = Group.Description };
            SelectedParentId = Group.ParentGroupId?.ToString() ?? string.Empty;

            var groups = await Api.GetGroupsAsync(null, 1, 200, TenantState.AllTenants).ConfigureAwait(false);
            AllGroups = groups?.Items ?? [];

            var roles = await Api.GetRolesAsync(null, 1, 200, TenantState.AllTenants).ConfigureAwait(false);
            AllRoles = roles?.Items ?? [];
        }
        catch (HttpRequestException)
        {
            Error = "The group could not be loaded.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string RoleName(Guid roleId)
        => AllRoles.FirstOrDefault(r => r.Id == roleId)?.Name ?? roleId.ToString();

    private async Task SaveAsync()
    {
        Busy = true;
        try
        {
            using var response = await Api.UpdateGroupAsync(Id, EditModel.Name, EditModel.Description, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The group could not be updated."; }
        finally { Busy = false; }
    }

    private async Task SetParentAsync()
    {
        Guid? parentId = Guid.TryParse(SelectedParentId, out var parsed) ? parsed : null;

        Busy = true;
        try
        {
            using var response = await Api.SetGroupParentAsync(Id, parentId, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The parent group could not be changed."; }
        finally { Busy = false; }
    }

    private async Task AssignRoleAsync()
    {
        if (!Guid.TryParse(SelectedRoleId, out var roleId))
            return;

        Busy = true;
        try
        {
            using var response = await Api.AssignGroupRoleAsync(Id, roleId, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            SelectedRoleId = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The role could not be assigned."; }
        finally { Busy = false; }
    }

    private async Task RemoveRoleAsync(Guid roleId)
    {
        Busy = true;
        try
        {
            using var response = await Api.RemoveGroupRoleAsync(Id, roleId, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The role could not be removed."; }
        finally { Busy = false; }
    }

    private async Task DeleteAsync()
    {
        Busy = true;
        try
        {
            using var response = await Api.DeleteGroupAsync(Id, TenantState.AllTenants).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo("/groups");
        }
        catch (HttpRequestException) { Error = "The group could not be deleted."; }
        finally { Busy = false; }
    }

    private void Back() => Navigation.NavigateTo("/groups");

    private sealed class EditGroupForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
