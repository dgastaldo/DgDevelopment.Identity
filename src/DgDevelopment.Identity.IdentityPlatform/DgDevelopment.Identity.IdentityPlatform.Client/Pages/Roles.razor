@page "/roles"
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@inject IdentityClient Api
@inject NavigationManager Navigation
@inject TenantState TenantState

<PageTitle>Roles | IdentityPlatform</PageTitle>

<RequirePermission Permission="identity-platform.role.read">
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
            <p class="mb-2 text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">RBAC</p>
            <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Roles</h1>
            <p class="mt-2 text-sm text-slate-500">Define reusable permission bundles that can be assigned to users and groups.</p>
        </div>
        <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-violet-800" @onclick="ToggleCreate">@(ShowCreate ? "Close form" : "Create role")</button>
    </div>

    @if (ShowCreate)
    {
        <section class="mb-6 rounded-2xl border border-violet-200 bg-violet-50 p-5">
            <h2 class="text-lg font-semibold text-slate-900">Create role</h2>
            <EditForm Model="CreateModel" OnValidSubmit="CreateAsync" class="mt-4 grid gap-4 md:grid-cols-3">
                <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Name</label><InputText @bind-Value="CreateModel.Name" class="w-full rounded-lg border-slate-300" /></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Description</label><InputText @bind-Value="CreateModel.Description" class="w-full rounded-lg border-slate-300" /></div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500 uppercase">Platform</label>
                    <select @bind="CreateModel.PlatformId" class="w-full rounded-lg border-slate-300 text-sm">
                        <option value="">Select a platform…</option>
                        @foreach (var platform in Platforms)
                        {
                            <option value="@platform.Id">@platform.Name</option>
                        }
                    </select>
                </div>
                <div class="md:col-span-3"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800" disabled="@(Busy || string.IsNullOrWhiteSpace(CreateModel.PlatformId))">Create role</button></div>
            </EditForm>
        </section>
    }

    <div class="mb-4 flex flex-col gap-3 sm:flex-row">
        <input @bind="Search" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" placeholder="Search roles" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm shadow-sm" />
        <button class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" @onclick="LoadAsync">Search</button>
    </div>

    @if (TenantState.AllTenants)
    {
        <div class="mb-4 rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs font-semibold text-violet-800">Viewing roles across all tenants</div>
    }

    @if (Error is not null)
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div>
    }
    else if (Loading)
    {
        <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
    }
    else if (RolePage is not null)
    {
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[600px] text-left text-sm">
                    <thead class="border-b border-slate-200 bg-slate-50 text-xs tracking-wide text-slate-500 uppercase"><tr><th class="px-5 py-4">Role</th><th class="px-5 py-4">Platform</th><th class="px-5 py-4">Permissions</th><th class="px-5 py-4"></th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var role in RolePage.Items)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-5 py-4"><a href="/roles/@role.Id" class="font-semibold text-slate-900 hover:text-violet-700">@role.Name</a><div class="text-xs text-slate-400">@role.Description</div></td>
                                <td class="px-5 py-4 text-slate-500">@PlatformName(role.PlatformId)</td>
                                <td class="px-5 py-4 text-slate-500">@role.Permissions.Count</td>
                                <td class="px-5 py-4 text-right"><a href="/roles/@role.Id" class="font-semibold text-violet-700 hover:text-violet-900">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between border-t border-slate-200 px-5 py-4 text-sm text-slate-500"><span>@RolePage.TotalCount roles</span><div class="flex gap-2"><button disabled="@(RolePage.Page <= 1)" @onclick="PreviousPage" class="rounded-md border border-slate-300 px-3 py-1.5 disabled:opacity-40">Previous</button><span class="px-2 py-1.5">@RolePage.Page / @RolePage.TotalPages</span><button disabled="@(RolePage.Page >= RolePage.TotalPages)" @onclick="NextPage" class="rounded-md border border-slate-300 px-3 py-1.5 disabled:opacity-40">Next</button></div></div>
        </section>
    }
</RequirePermission>

@code {
    private PagedRolesResponse? RolePage;
    private IReadOnlyCollection<PlatformResponse> Platforms = [];
    private string Search = string.Empty;
    private int Page = 1;
    private bool Loading = true;
    private bool Busy;
    private bool ShowCreate;
    private string? Error;
    private CreateRoleForm CreateModel = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            RolePage = await Api.GetRolesAsync(Search, Page, 20, TenantState.AllTenants).ConfigureAwait(false);
            if (RolePage is null) Error = "The role list returned no data.";

            var platforms = await Api.GetPlatformsAsync(null, 1, 200, TenantState.AllTenants).ConfigureAwait(false);
            Platforms = platforms?.Items ?? [];
        }
        catch (HttpRequestException)
        {
            Error = "The role list is currently unavailable.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string PlatformName(Guid platformId)
        => Platforms.FirstOrDefault(p => p.Id == platformId)?.Name ?? platformId.ToString();

    private async Task CreateAsync()
    {
        if (!Guid.TryParse(CreateModel.PlatformId, out var platformId))
            return;

        Busy = true;
        try
        {
            await Api.CreateRoleAsync(CreateModel.Name, CreateModel.Description, platformId).ConfigureAwait(false);
            CreateModel = new();
            ShowCreate = false;
            await LoadAsync();
        }
        catch (HttpRequestException) { Error = "The role could not be created."; }
        finally { Busy = false; }
    }

    private void ToggleCreate() => ShowCreate = !ShowCreate;
    private async Task PreviousPage() { if (Page > 1) { Page--; await LoadAsync(); } }
    private async Task NextPage() { if (RolePage is not null && Page < RolePage.TotalPages) { Page++; await LoadAsync(); } }
    private async Task HandleSearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") { Page = 1; await LoadAsync(); } }

    private sealed class CreateRoleForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string PlatformId { get; set; } = string.Empty;
    }
}
