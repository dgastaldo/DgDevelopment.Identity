@page "/users/{Id:guid}"
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@inject IdentityClient Api
@inject NavigationManager Navigation
@inject TenantState TenantState

<PageTitle>User details | IdentityPlatform</PageTitle>

<RequirePermission Permission="identity-platform.user.read">
    @if (Loading)
    {
        <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
    }
    else if (User is null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm text-rose-800">@Error</div>
    }
    else
    {
        <div class="mb-8 flex items-end justify-between gap-4"><div><button class="mb-4 text-sm font-semibold text-violet-700" @onclick="Back">← Users</button><p class="text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">Account detail</p><h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">@User.Username</h1><p class="mt-2 text-sm text-slate-500">@User.Email</p></div><span class="rounded-full px-3 py-1 text-xs font-semibold @(User.IsLocked ? "bg-amber-50 text-amber-700" : User.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(User.IsLocked ? "Locked" : User.IsActive ? "Active" : "Inactive")</span></div>
        @if (Error is not null) { <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div> }
        <div class="grid gap-6 lg:grid-cols-[1fr_0.7fr]">
            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Profile</p><dl class="mt-5 grid gap-5 sm:grid-cols-2"><div><dt class="text-xs text-slate-400">Account ID</dt><dd class="mt-1 break-all text-sm font-medium text-slate-700">@User.Id</dd></div><div><dt class="text-xs text-slate-400">MFA policy</dt><dd class="mt-1 text-sm font-medium text-slate-700">@(User.RequireMfa ? "Required" : "Optional")</dd></div><div><dt class="text-xs text-slate-400">Created</dt><dd class="mt-1 text-sm font-medium text-slate-700">@User.CreatedAt.ToLocalTime()</dd></div><div><dt class="text-xs text-slate-400">System account</dt><dd class="mt-1 text-sm font-medium text-slate-700">@(User.IsSystemAccount ? "Yes" : "No")</dd></div></dl></section>
            <section class="rounded-2xl bg-slate-900 p-6 text-white shadow-sm"><p class="text-xs font-semibold tracking-[0.16em] text-violet-300 uppercase">Actions</p><div class="mt-5 grid gap-3"><button disabled="@Busy" @onclick="ToggleLock" class="rounded-lg bg-white/10 px-4 py-2 text-left text-sm font-semibold hover:bg-white/20">@(User.IsLocked ? "Unlock account" : "Lock account")</button><button disabled="@(Busy || User.IsSystemAccount || !User.IsActive)" @onclick="Deactivate" class="rounded-lg bg-rose-400/20 px-4 py-2 text-left text-sm font-semibold text-rose-200 hover:bg-rose-400/30">Deactivate account</button></div></section>
        </div>
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Credentials</p><div class="mt-4 flex flex-col gap-3 sm:flex-row"><input @bind="NewPassword" type="password" placeholder="New temporary password" class="flex-1 rounded-lg border-slate-300 text-sm" /><button disabled="@(Busy || string.IsNullOrWhiteSpace(NewPassword))" @onclick="ResetPassword" class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:opacity-50">Reset password</button></div></section>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Roles</p>
                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <select @bind="SelectedRoleId" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm">
                        <option value="">Select a role to add…</option>
                        @foreach (var role in AvailableRoles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                    <button disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedRoleId))" @onclick="AssignRoleAsync" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:opacity-50">Assign</button>
                </div>
                <ul class="mt-5 divide-y divide-slate-100">
                    @foreach (var assigned in User.Roles)
                    {
                        <li class="flex items-center justify-between py-3">
                            <p class="text-sm font-semibold text-slate-800">@RoleName(assigned.RoleId)</p>
                            <button disabled="@Busy" @onclick="() => RemoveRoleAsync(assigned.RoleId)" class="text-xs font-semibold text-rose-600 hover:text-rose-800">Remove</button>
                        </li>
                    }
                    @if (User.Roles.Count == 0)
                    {
                        <li class="py-3 text-sm text-slate-400">No roles assigned yet.</li>
                    }
                </ul>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Groups</p>
                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <select @bind="SelectedGroupId" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm">
                        <option value="">Select a group to add…</option>
                        @foreach (var group in AvailableGroups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                    <button disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedGroupId))" @onclick="AssignGroupAsync" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:opacity-50">Assign</button>
                </div>
                <ul class="mt-5 divide-y divide-slate-100">
                    @foreach (var assigned in User.Groups)
                    {
                        <li class="flex items-center justify-between py-3">
                            <p class="text-sm font-semibold text-slate-800">@GroupName(assigned.GroupId)</p>
                            <button disabled="@Busy" @onclick="() => RemoveGroupAsync(assigned.GroupId)" class="text-xs font-semibold text-rose-600 hover:text-rose-800">Remove</button>
                        </li>
                    }
                    @if (User.Groups.Count == 0)
                    {
                        <li class="py-3 text-sm text-slate-400">No groups assigned yet.</li>
                    }
                </ul>
            </section>
        </div>

        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold tracking-[0.16em] text-slate-400 uppercase">Direct permissions</p>
            <p class="mt-1 text-xs text-slate-400">Granted straight to this user, in addition to whatever roles and groups contribute.</p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                <select @bind="SelectedPermissionId" class="min-w-0 flex-1 rounded-lg border-slate-300 text-sm">
                    <option value="">Select a permission to add…</option>
                    @foreach (var permission in AvailablePermissions)
                    {
                        <option value="@permission.Id">@permission.Name</option>
                    }
                </select>
                <button disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedPermissionId))" @onclick="AssignPermissionAsync" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-800 disabled:opacity-50">Assign</button>
            </div>
            <ul class="mt-5 divide-y divide-slate-100">
                @foreach (var assigned in User.Permissions)
                {
                    <li class="flex items-center justify-between py-3">
                        <p class="text-sm font-semibold text-slate-800">@PermissionName(assigned.PermissionId)</p>
                        <button disabled="@Busy" @onclick="() => RemovePermissionAsync(assigned.PermissionId)" class="text-xs font-semibold text-rose-600 hover:text-rose-800">Remove</button>
                    </li>
                }
                @if (User.Permissions.Count == 0)
                {
                    <li class="py-3 text-sm text-slate-400">No direct permissions assigned.</li>
                }
            </ul>
        </section>
    }
</RequirePermission>

@code {
    [Parameter] public Guid Id { get; set; }
    private UserResponse? User;
    private IReadOnlyCollection<RoleResponse> AllRoles = [];
    private IReadOnlyCollection<GroupResponse> AllGroups = [];
    private IReadOnlyCollection<PermissionResponse> AllPermissions = [];
    private bool Loading = true;
    private bool Busy;
    private string NewPassword = string.Empty;
    private string? Error;
    private string SelectedRoleId = string.Empty;
    private string SelectedGroupId = string.Empty;
    private string SelectedPermissionId = string.Empty;

    private IEnumerable<RoleResponse> AvailableRoles
        => AllRoles.Where(r => User is not null && User.Roles.All(ur => ur.RoleId != r.Id));

    private IEnumerable<GroupResponse> AvailableGroups
        => AllGroups.Where(g => User is not null && User.Groups.All(ug => ug.GroupId != g.Id));

    private IEnumerable<PermissionResponse> AvailablePermissions
        => AllPermissions.Where(p => User is not null && User.Permissions.All(up => up.PermissionId != p.Id));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            User = await Api.GetUserAsync(Id, TenantState.AllTenants).ConfigureAwait(false);
            if (User is null) { Error = "User not found."; return; }

            var roles = await Api.GetRolesAsync(null, 1, 200, TenantState.AllTenants).ConfigureAwait(false);
            AllRoles = roles?.Items ?? [];

            var groups = await Api.GetGroupsAsync(null, 1, 200, TenantState.AllTenants).ConfigureAwait(false);
            AllGroups = groups?.Items ?? [];

            var permissions = await Api.GetPermissionsAsync(pageSize: 200, allTenants: TenantState.AllTenants).ConfigureAwait(false);
            AllPermissions = permissions?.Items ?? [];
        }
        catch (HttpRequestException)
        {
            Error = "The user could not be loaded.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string RoleName(Guid roleId) => AllRoles.FirstOrDefault(r => r.Id == roleId)?.Name ?? roleId.ToString();
    private string GroupName(Guid groupId) => AllGroups.FirstOrDefault(g => g.Id == groupId)?.Name ?? groupId.ToString();
    private string PermissionName(Guid permissionId) => AllPermissions.FirstOrDefault(p => p.Id == permissionId)?.Name ?? permissionId.ToString();

    private async Task ToggleLock()
    {
        Busy = true;
        try { using var response = User!.IsLocked ? await Api.UnlockUserAsync(Id, TenantState.AllTenants) : await Api.LockUserAsync(Id, TenantState.AllTenants); response.EnsureSuccessStatusCode(); await LoadAsync(); }
        catch (HttpRequestException) { Error = "The account status could not be changed."; }
        finally { Busy = false; }
    }

    private async Task Deactivate()
    {
        Busy = true;
        try { using var response = await Api.DeactivateUserAsync(Id, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); Navigation.NavigateTo("/users"); }
        catch (HttpRequestException) { Error = "The account could not be deactivated."; }
        finally { Busy = false; }
    }

    private async Task ResetPassword()
    {
        Busy = true;
        try { using var response = await Api.ResetPasswordAsync(Id, NewPassword, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); NewPassword = string.Empty; }
        catch (HttpRequestException) { Error = "The password could not be reset."; }
        finally { Busy = false; }
    }

    private async Task AssignRoleAsync()
    {
        if (!Guid.TryParse(SelectedRoleId, out var roleId)) return;
        Busy = true;
        try { using var response = await Api.AssignUserRoleAsync(Id, roleId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); SelectedRoleId = string.Empty; await LoadAsync(); }
        catch (HttpRequestException) { Error = "The role could not be assigned."; }
        finally { Busy = false; }
    }

    private async Task RemoveRoleAsync(Guid roleId)
    {
        Busy = true;
        try { using var response = await Api.RemoveUserRoleAsync(Id, roleId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); await LoadAsync(); }
        catch (HttpRequestException) { Error = "The role could not be removed."; }
        finally { Busy = false; }
    }

    private async Task AssignGroupAsync()
    {
        if (!Guid.TryParse(SelectedGroupId, out var groupId)) return;
        Busy = true;
        try { using var response = await Api.AssignUserGroupAsync(Id, groupId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); SelectedGroupId = string.Empty; await LoadAsync(); }
        catch (HttpRequestException) { Error = "The group could not be assigned."; }
        finally { Busy = false; }
    }

    private async Task RemoveGroupAsync(Guid groupId)
    {
        Busy = true;
        try { using var response = await Api.RemoveUserGroupAsync(Id, groupId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); await LoadAsync(); }
        catch (HttpRequestException) { Error = "The group could not be removed."; }
        finally { Busy = false; }
    }

    private async Task AssignPermissionAsync()
    {
        if (!Guid.TryParse(SelectedPermissionId, out var permissionId)) return;
        Busy = true;
        try { using var response = await Api.AssignUserPermissionAsync(Id, permissionId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); SelectedPermissionId = string.Empty; await LoadAsync(); }
        catch (HttpRequestException) { Error = "The permission could not be assigned."; }
        finally { Busy = false; }
    }

    private async Task RemovePermissionAsync(Guid permissionId)
    {
        Busy = true;
        try { using var response = await Api.RemoveUserPermissionAsync(Id, permissionId, TenantState.AllTenants).ConfigureAwait(false); response.EnsureSuccessStatusCode(); await LoadAsync(); }
        catch (HttpRequestException) { Error = "The permission could not be removed."; }
        finally { Busy = false; }
    }

    private void Back() => Navigation.NavigateTo("/users");
}
