@page "/audit"
@using DgDevelopment.Identity.IdentityPlatform.Client.State
@inject IdentityClient Api
@inject TenantState TenantState

<PageTitle>Audit log | IdentityPlatform</PageTitle>

<RequirePermission Permission="identity-platform.audit.read">
    <div class="mb-8">
        <p class="mb-2 text-xs font-semibold tracking-[0.2em] text-violet-700 uppercase">Compliance</p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Audit log</h1>
        <p class="mt-2 text-sm text-slate-500">Every administrative action recorded against this tenant.</p>
    </div>

    <div class="mb-4 grid gap-3 sm:grid-cols-4">
        <input @bind="ActionFilter" placeholder="Action (e.g. role.create)" class="rounded-lg border-slate-300 text-sm shadow-sm" />
        <input @bind="TargetIdFilter" placeholder="Target ID" class="rounded-lg border-slate-300 text-sm shadow-sm" />
        <input @bind="FromFilter" type="date" class="rounded-lg border-slate-300 text-sm shadow-sm" />
        <input @bind="ToFilter" type="date" class="rounded-lg border-slate-300 text-sm shadow-sm" />
    </div>
    <div class="mb-4">
        <button class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" @onclick="ApplyFilters">Filter</button>
    </div>

    @if (TenantState.AllTenants)
    {
        <div class="mb-4 rounded-xl border border-violet-200 bg-violet-50 p-3 text-xs font-semibold text-violet-800">Viewing audit entries across all tenants</div>
    }

    @if (Error is not null)
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">@Error</div>
    }
    else if (Loading)
    {
        <div class="h-64 animate-pulse rounded-2xl bg-slate-100"></div>
    }
    else if (LogPage is not null)
    {
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[800px] text-left text-sm">
                    <thead class="border-b border-slate-200 bg-slate-50 text-xs tracking-wide text-slate-500 uppercase"><tr><th class="px-5 py-4">Timestamp</th><th class="px-5 py-4">Action</th><th class="px-5 py-4">Target</th><th class="px-5 py-4">Actor</th><th class="px-5 py-4">Outcome</th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var entry in LogPage.Items)
                        {
                            <tr>
                                <td class="px-5 py-4 whitespace-nowrap text-slate-500">@entry.Timestamp.ToLocalTime().ToString("g")</td>
                                <td class="px-5 py-4 font-semibold text-slate-900">@entry.Action</td>
                                <td class="px-5 py-4 text-slate-500"><span class="text-xs">@entry.TargetType</span> @entry.TargetId</td>
                                <td class="px-5 py-4 text-slate-500">@(entry.ActorId?.ToString() ?? entry.ActorType ?? "system")</td>
                                <td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold @(entry.Outcome == AuditOutcome.Success ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">@entry.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between border-t border-slate-200 px-5 py-4 text-sm text-slate-500"><span>@LogPage.TotalCount entries</span><div class="flex gap-2"><button disabled="@(LogPage.Page <= 1)" @onclick="PreviousPage" class="rounded-md border border-slate-300 px-3 py-1.5 disabled:opacity-40">Previous</button><span class="px-2 py-1.5">@LogPage.Page / @LogPage.TotalPages</span><button disabled="@(LogPage.Page >= LogPage.TotalPages)" @onclick="NextPage" class="rounded-md border border-slate-300 px-3 py-1.5 disabled:opacity-40">Next</button></div></div>
        </section>
    }
</RequirePermission>

@code {
    private PagedAuditLogResponse? LogPage;
    private int Page = 1;
    private bool Loading = true;
    private string? Error;
    private string ActionFilter = string.Empty;
    private string TargetIdFilter = string.Empty;
    private DateTime? FromFilter;
    private DateTime? ToFilter;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OperatingSystem.IsBrowser())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            LogPage = await Api.GetAuditLogsAsync(
                action: string.IsNullOrWhiteSpace(ActionFilter) ? null : ActionFilter,
                targetId: string.IsNullOrWhiteSpace(TargetIdFilter) ? null : TargetIdFilter,
                from: FromFilter,
                to: ToFilter,
                page: Page,
                pageSize: 20,
                allTenants: TenantState.AllTenants).ConfigureAwait(false);
            if (LogPage is null) Error = "The audit log returned no data.";
        }
        catch (HttpRequestException)
        {
            Error = "The audit log is currently unavailable.";
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyFilters() { Page = 1; await LoadAsync(); }
    private async Task PreviousPage() { if (Page > 1) { Page--; await LoadAsync(); } }
    private async Task NextPage() { if (LogPage is not null && Page < LogPage.TotalPages) { Page++; await LoadAsync(); } }
}
