@inherits LayoutComponentBase
@using DgDevelopment.Identity.Client.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@inject IdentityAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="layout-wrapper">
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <div class="auth-area">
                    <AuthorizeView>
                        <Authorized>
                            <span class="avatar">@GetInitials(context.User.Identity?.Name)</span>
                            <span class="username">@context.User.Identity?.Name</span>
                            <button type="button" class="btn-link" @onclick="LogoutAsync">Logout</button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login">Login</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <footer class="footer">
        <span>DgDevelopment.Identity by <a href="https://github.com/dgastaldo" target="_blank">dgastaldo</a></span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split([' ', '.', '-', '_'], StringSplitOptions.RemoveEmptyEntries);

        var initials = parts
            .Select(p => p[0])
            .Take(2)
            .Select(char.ToUpperInvariant)
            .ToArray();

        return new string(initials);
    }

    private async Task LogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
