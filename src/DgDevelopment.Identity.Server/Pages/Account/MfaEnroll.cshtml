@page "/account/mfa-enroll"
@model DgDevelopment.Identity.Server.Pages.Account.MfaEnrollModel
@{
    ViewData["Title"] = "Two-factor authentication required";
}

<div class="auth-card">
    <h1 class="auth-brand">DgDevelopment Identity Server</h1>
    <h2 class="text-lg font-semibold text-gray-800 mb-2">Two-factor authentication required</h2>

    @if (Model.Enrolled)
    {
        <p class="text-sm text-gray-600 mb-4">
            Two-factor authentication is now active on your account. Save these backup codes
            somewhere safe - each one can be used once if you lose access to your authenticator app.
        </p>
        <ul class="text-sm font-mono bg-gray-100 rounded p-3 mb-4 space-y-1">
            @foreach (var code in Model.BackupCodes ?? [])
            {
                <li>@code</li>
            }
        </ul>
        <a class="auth-btn block text-center" href="@Model.ReturnUrl">Continue</a>
    }
    else
    {
        <p class="text-sm text-gray-600 mb-4">
            Administrator accounts require two-factor authentication. Scan the QR code with an
            authenticator app, then enter the 6-digit code to activate it.
        </p>

        <div class="flex justify-center mb-4">
            <img src="@Model.QrCodeDataUri" alt="TOTP provisioning QR code" class="h-48 w-48" />
        </div>

        <div class="mb-4 text-center">
            <p class="text-xs text-gray-500 mb-1">Or enter this key manually:</p>
            <code class="bg-gray-100 rounded px-2 py-1 text-sm break-all">@Model.EnrollmentSecret</code>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="mb-3">
                <label class="auth-label" for="code">6-digit code</label>
                <input class="auth-input" id="code" name="Code" type="text" inputmode="numeric"
                       pattern="[0-9]*" maxlength="6" required autofocus autocomplete="one-time-code" />
            </div>
            <button type="submit" class="auth-btn">Activate</button>
        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-alert">@Html.ValidationSummary()</div>
        }
    }
</div>
