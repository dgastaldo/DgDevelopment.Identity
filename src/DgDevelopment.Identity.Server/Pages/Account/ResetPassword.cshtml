@page "/account/reset-password"
@model DgDevelopment.Identity.Server.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-card">
    <h1 class="auth-brand">DgDevelopment Identity Server</h1>
    @if (Model.InvalidToken)
    {
        <p class="text-sm text-gray-600 text-center">This password reset link is invalid or has expired.</p>
        <p class="text-sm text-center mt-4"><a href="/account/forgot-password">Request a new link</a></p>
    }
    else if (Model.Success)
    {
        <p class="text-sm text-gray-600 text-center">Your password has been reset.</p>
        <p class="text-sm text-center mt-4"><a href="/account/login">Back to sign in</a></p>
    }
    else
    {
        <form method="post">
            <input type="hidden" name="Token" value="@Model.Token" />
            <div class="mb-3">
                <label class="auth-label" for="password">New password</label>
                <input class="auth-input" id="password" name="Password" type="password"
                       required autofocus autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label class="auth-label" for="confirmPassword">Confirm new password</label>
                <input class="auth-input" id="confirmPassword" name="ConfirmPassword" type="password"
                       required autocomplete="new-password" />
            </div>
            <button type="submit" class="auth-btn">Reset password</button>
        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-alert">@Html.ValidationSummary()</div>
        }
    }
</div>
