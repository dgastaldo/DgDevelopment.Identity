@page "/account/forgot-password"
@model DgDevelopment.Identity.Server.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <h1 class="auth-brand">DgDevelopment Identity Server</h1>
    <p class="text-sm text-gray-600 mb-4 text-center">Enter your email address and we'll send you a link to reset your password.</p>
    <form method="post">
        <div class="mb-3">
            <label class="auth-label" for="email">Email</label>
            <input class="auth-input" id="email" name="Email" type="email"
                   value="@Model.Email" required autofocus autocomplete="email" spellcheck="false" />
        </div>
        <button type="submit" class="auth-btn">Send reset link</button>
    </form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">@Html.ValidationSummary()</div>
    }
    <p class="text-sm text-center mt-4"><a href="/account/login">Back to sign in</a></p>
</div>
