@page "/account/password"
@model DgDevelopment.Identity.Server.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <h1 class="auth-brand">DgDevelopment Identity Server</h1>
    <p class="text-sm text-gray-600 mb-4 text-center">Hi <span class="font-medium">@Model.Username</span>, enter your password to continue.</p>
    <form method="post">
        <input type="hidden" name="Username" value="@Model.Username" />
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        }
        <div class="mb-3">
            <label class="auth-label" for="password">Password</label>
            <input class="auth-input" id="password" name="Password" type="password"
                   required autofocus autocomplete="current-password" />
        </div>
        <div class="mb-3">
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input class="h-4 w-4 rounded border-gray-300 text-brand-700 focus:ring-brand-500"
                       type="checkbox" name="RememberMe" value="true" />
                Remember me
            </label>
        </div>
        <button type="submit" class="auth-btn">Sign in</button>
    </form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">@Html.ValidationSummary()</div>
    }
</div>