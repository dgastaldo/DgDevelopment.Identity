@page "/account/expired-password"
@model DgDevelopment.Identity.Server.Pages.Account.ExpiredPasswordModel
@{
    ViewData["Title"] = "Update your password";
}

<div class="auth-card">
    <h1 class="auth-brand">DgDevelopment Identity Server</h1>
    <h2 class="text-lg font-semibold text-gray-800 mb-2">Update your password</h2>
    <p class="text-sm text-gray-600 mb-4">Your password has expired. Choose a new one to continue.</p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div class="mb-3">
            <label class="auth-label" for="password">New password</label>
            <input class="auth-input" id="password" name="Password" type="password"
                   required autofocus autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label class="auth-label" for="confirmPassword">Confirm new password</label>
            <input class="auth-input" id="confirmPassword" name="ConfirmPassword" type="password"
                   required autocomplete="new-password" />
        </div>
        <button type="submit" class="auth-btn">Update password</button>
    </form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">@Html.ValidationSummary()</div>
    }
</div>
