<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DgDevelopment Identity</title>
    <link rel="stylesheet" href="~/css/tailwind.css" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50">
    <main class="flex-1 flex items-center justify-center p-4">
        @RenderBody()
    </main>
    <footer class="bg-gray-100 border-t border-gray-300 py-3 px-6 text-center text-sm text-gray-500">
        DgDevelopment Identity Server &copy; 2026 - @DateTime.Now.Year by Daniele Gastaldo
    </footer>
</body>
</html>